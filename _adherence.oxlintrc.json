        "selector": "JSXOpeningElement[name.name='CognitiveAlertBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:fatigue|attention|trap|info)$/]",
        "message": "<CognitiveAlertBanner> tone must be one of 'fatigue' | 'attention' | 'trap' | 'info'."
