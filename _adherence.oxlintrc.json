{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/flashcards/**",
              "components/mindmap/**",
              "components/navigation/**",
              "components/questions/**",
              "components/study/**",
              "components/tutor/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Cormorant Garamond|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Cormorant Garamond, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementEmblem'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|state|size|progress|rule|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<AchievementEmblem> doesn't accept that prop. Declared props: variant, state, size, progress, rule, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementEmblem'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soldado|sabio|estrategista|ascensao)$/]",
        "message": "<AchievementEmblem> variant must be one of 'soldado' | 'sabio' | 'estrategista' | 'ascensao'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementEmblem'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:earned|in-progress|locked)$/]",
        "message": "<AchievementEmblem> state must be one of 'earned' | 'in-progress' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|allowSkip|onConfirm|onNext|onSkip|onReview|onOpenFeedback|reviewMarked|showHints|sticky|style|key|ref|className|style|children)$/]",
        "message": "<AnswerActionBar> doesn't accept that prop. Declared props: state, allowSkip, onConfirm, onNext, onSkip, onReview, onOpenFeedback, reviewMarked, showHints, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerActionBar'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|ready|loading|answered)$/]",
        "message": "<AnswerActionBar> state must be one of 'idle' | 'ready' | 'loading' | 'answered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|gold|correct|incorrect|no-evidence|attention|crimson)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'gold' | 'correct' | 'incorrect' | 'no-evidence' | 'attention' | 'crimson'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandHeaderItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<BrandHeaderItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|mark|showMotto|align|style|key|ref|className|style|children)$/]",
        "message": "<BrandLogo> doesn't accept that prop. Declared props: variant, size, mark, showMotto, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLogo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal|wordmark|vertical|app-icon|mark)$/]",
        "message": "<BrandLogo> variant must be one of 'horizontal' | 'wordmark' | 'vertical' | 'app-icon' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLogo'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:q-sword|sword|mountain|mountain-ribbon)$/]",
        "message": "<BrandLogo> mark must be one of 'q-sword' | 'sword' | 'mountain' | 'mountain-ribbon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLogo'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<BrandLogo> align must be one of 'start' | 'center'."
      },
