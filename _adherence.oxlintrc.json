        "selector": "JSXOpeningElement[name.name='ConceptPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|path|mastery|summary|example|connections|sources|onNavigate|onReview|reviewCount|returnTo|onReturn|onClose|style|key|ref|className|style|children)$/]",
        "message": "<ConceptPanel> doesn't accept that prop. Declared props: title, path, mastery, summary, example, connections, sources, onNavigate, onReview, reviewCount, returnTo, onReturn, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackDrawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|mode|onClose|result|answerKey|explanation|legalBasis|trap|concept|onOpenConcept|onFlashcards|style|key|ref|className|style|children)$/]",
        "message": "<FeedbackDrawer> doesn't accept that prop. Declared props: open, mode, onClose, result, answerKey, explanation, legalBasis, trap, concept, onOpenConcept, onFlashcards, style."
      },
